POSTGRES_DB=medishield
POSTGRES_TEST_DB=medishield_test
POSTGRES_USER=medishield
POSTGRES_PASSWORD=replace-with-local-only-password
APP_ENV=development

DATABASE_URL=postgresql+psycopg://medishield:replace-with-local-only-password@127.0.0.1:5432/medishield
TEST_DATABASE_URL=postgresql+psycopg://medishield:replace-with-local-only-password@127.0.0.1:5432/medishield_test
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=medishield-local
S3_SECRET_KEY=replace-with-local-only-secret
S3_BUCKET=medishield-documents
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-local-only-key
LLM_PROVIDER=anthropic
LLM_VISION_MODEL=replace-with-model-id
LLM_TEXT_MODEL=replace-with-model-id
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=replace-with-model-id
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
THRESH_FRAUD_ESCALATE=0.30
THRESH_FRAUD_HIGH=0.60
THRESH_AGENT_CONFIDENCE=0.60
THRESH_CLASSIFY_REVIEW=0.60
NPI_LUHN_STRICT=false
ALLOW_RECEIVED_AT_OVERRIDE=false
NEAR_THRESHOLD_LOW=9500
NEAR_THRESHOLD_HIGH=10000
DATE_CONFLICT_DAYS=30
READMISSION_DAYS=30
MAX_UPLOAD_MB=25
PIPELINE_TIMEOUT_S=300
AGENT_TIMEOUT_S=90
JWT_SECRET=replace-with-local-only-secret
JWT_TTL_MIN=60
SEED_TEST_USER_PASSWORD=replace-with-local-test-password
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
PHI_LOG_REDACTION=true